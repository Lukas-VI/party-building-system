# ──────────────────────────────────────────────
# PC 后台 (admin-desktop) 环境变量
# 复制此文件为 .env 后按需修改
# ──────────────────────────────────────────────

# API 地址（必填）
# 生产环境 Nginx 反代: /DJ_api
# 本地开发直连 API:   http://127.0.0.1:3000/api
VITE_API_BASE=/DJ_api

# 前端部署路径前缀
VITE_DESKTOP_PATH=/admin-desktop/
VITE_MOBILE_PATH=/wx-app/

# 跨设备跳转用的完整 URL
VITE_DESKTOP_ADMIN_URL=https://havensky.cn/admin-desktop/
VITE_WX_APP_URL=https://havensky.cn/wx-app/

# ── Vite 开发服务器（仅本地 dev 生效，生产构建忽略）──

# 放行域名（逗号分隔）
ALLOWED_HOSTS=havensky.cn,www.havensky.cn,192.168.31.135,localhost,127.0.0.1

# /api 和 /uploads 的代理目标（本地联调用）
API_PROXY_TARGET=http://192.168.31.135:3000

# /DJ_api 的代理目标（本地未跑 API 时可选）
DJ_API_PROXY_TARGET=https://havensky.cn
