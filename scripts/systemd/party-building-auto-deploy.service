[Unit]
Description=Auto deploy Party Building main branch
Wants=network-online.target
After=network-online.target mysql.service frpc.service

[Service]
Type=oneshot
User=havensky
WorkingDirectory=/opt/party-building-mini-app
Environment=ROOT_DIR=/opt/party-building-mini-app
Environment=BRANCH=main
Environment=REMOTE=origin
ExecStart=/bin/bash /opt/party-building-mini-app/scripts/auto-deploy-main.sh
